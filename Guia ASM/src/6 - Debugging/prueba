def ejercicio4(direccion_array, n, C):
    direcnueva = malloc 4 * n(para el array) 
    i=0
    while i < n:
        direcnueva[i] = [direccion_array[i]]*C
        free(direccion_array[i])
        direccion_array[i]=NULL
        i++
    return direcnueva

